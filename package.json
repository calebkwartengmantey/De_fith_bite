{
  "name": "de-5th-bite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply de-5th-bite --local",
    "db:remote": "wrangler d1 migrations apply de-5th-bite --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.152.0"
  }
}
